;; Clojure is supplied by Jolt and is terminal during dependency expansion.
;; Explicit spec coordinates remain ordinary dependencies and must be acquired.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/spec.alpha {:mvn/version "0.5.238"}
        org.clojure/core.specs.alpha {:mvn/version "0.4.74"}}}
