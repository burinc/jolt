  (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "definterface" "Creates a new Java interface with the given name and method sigs.\n  The method return types and parameter types may be specified with type hints,\n  defaulting to Object if omitted.\n\n  (definterface MyInterface\n    (^int method1 [x])\n    (^Bar method2 [^Baz b ^Quux q]))" (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "&") (jolt-symbol #f "sigs")))))
