  (jolt-invoke4 (var-deref "clojure.core" "attach-core-doc-meta!") "clojure.core" "defmacro" "Like defn, but the resulting function name is declared as a\n  macro and will be used as a macro by the compiler when it is\n  called." (jolt-list (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "body")) (jolt-vector (jolt-symbol #f "name") (jolt-symbol #f "doc-string?") (jolt-symbol #f "attr-map?") (jolt-list (jolt-vector (jolt-symbol #f "params*")) (jolt-symbol #f "body")) (jolt-symbol #f "+") (jolt-symbol #f "attr-map?")))))
