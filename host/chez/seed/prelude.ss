  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "every?" "Returns true if (pred x) is logical true for every x in coll, else\n  false." (jolt-list (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll"))) (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "java.lang.Boolean")))
(guard (e (#t #f))
