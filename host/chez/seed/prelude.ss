  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "seq" "Returns a seq on the collection. If the collection is\n    empty, returns nil.  (seq nil) returns nil. seq also works on\n    Strings, native Java arrays (of reference types) and any objects\n    that implement Iterable. Note that seqs cache values, thus seq\n    should not be used on any Iterable whose iterator repeatedly\n    returns the same mutable object." (jolt-list (jolt-vector (jolt-symbol #f "coll"))) (jolt-invoke1 (var-deref "jolt.host" "jolt-class-for") "clojure.lang.ISeq")))
