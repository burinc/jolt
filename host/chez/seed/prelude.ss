  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "conj!" "Adds x to the transient collection, and return coll. The 'addition'\n  may happen at different 'places' depending on the concrete type." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")))))
