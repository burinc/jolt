  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "disj!" "disj[oin]. Returns a transient set of the same (hashed/sorted) type, that\n  does not contain key(s)." (jolt-list (jolt-vector (jolt-symbol #f "set")) (jolt-vector (jolt-symbol #f "set") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "set") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dissoc" "dissoc[iate]. Returns a new map of the same (hashed/sorted) type,\n  that does not contain a mapping for key(s)." (jolt-list (jolt-vector (jolt-symbol #f "map")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dissoc!" "Returns a transient map that doesn't contain a mapping for key(s)." (jolt-list (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "distinct" "Returns a lazy sequence of the elements of coll with duplicates removed.\n  Returns a stateful transducer when no collection is provided." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "distinct?" "Returns true if no two of the arguments are =" (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "doall" "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. doall can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, retains the head and returns it, thus causing the entire\n  seq to reside in memory at one time." (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dorun" "When lazy sequences are produced via functions that have side\n  effects, any effects other than those needed to produce the first\n  element in the seq do not occur until the seq is consumed. dorun can\n  be used to force any effects. Walks through the successive nexts of\n  the seq, does not retain the head and returns nil." (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "doseq" "Repeatedly executes body (presumably for side-effects) with\n  bindings and filtering as provided by \"for\".  Does not retain\n  the head of the sequence. Returns nil." (jolt-list (jolt-vector (jolt-symbol #f "seq-exprs") (jolt-symbol #f "&") (jolt-symbol #f "body")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dosync" "Runs the exprs (in an implicit do) in a transaction that encompasses\n  exprs and any nested calls.  Starts a transaction if none is already\n  running on this thread. Any uncaught exception will abort the\n  transaction and flow out of dosync. The exprs may be run more than\n  once, but any effects on Refs will be atomic." (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "exprs")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dotimes" "bindings => name n\n\n  Repeatedly executes body (presumably for side-effects) with name\n  bound to integers from 0 through n-1." (jolt-list (jolt-vector (jolt-symbol #f "bindings") (jolt-symbol #f "&") (jolt-symbol #f "body")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "doto" "Evaluates x then calls all of the methods and functions with the\n  value of x supplied at the front of the given arguments.  The forms\n  are evaluated in order.  Returns x.\n\n  (doto (new java.util.HashMap) (.put \"a\" 1) (.put \"b\" 2))" (jolt-list (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "forms")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "double" "Coerce to double" (jolt-list (jolt-vector (jolt-symbol #f "x")))))
