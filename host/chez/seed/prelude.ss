  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "range" "Returns a lazy seq of nums from start (inclusive) to end\n  (exclusive), by step, where start defaults to 0, step to 1, and end to\n  infinity. When step is equal to 0, returns an infinite sequence of\n  start. When start is equal to end, returns empty list." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "end")) (jolt-vector (jolt-symbol #f "start") (jolt-symbol #f "end")) (jolt-vector (jolt-symbol #f "start") (jolt-symbol #f "end") (jolt-symbol #f "step")))))
