  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "partition-all" "Returns a lazy sequence of lists like partition, but may include\n  partitions with fewer than n items at the end.  Returns a stateful\n  transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "n")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "step") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "partition-by" "Applies f to each value in coll, splitting it each time f returns a\n   new value.  Returns a lazy seq of partitions.  Returns a stateful\n   transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "coll")))))
