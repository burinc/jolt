(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.template" "do-template" "Repeatedly copies expr (in a do block) for each group of arguments\n  in values.  values are automatically partitioned by the number of\n  arguments in argv, an argument vector as in defn.\n\n  Example: (macroexpand '(do-template [x y] (+ y x) 2 4 3 5))\n           ;=> (do (+ 4 2) (+ 5 3))" (jolt-list (jolt-vector (jolt-symbol #f "argv") (jolt-symbol #f "expr") (jolt-symbol #f "&") (jolt-symbol #f "values")))))
