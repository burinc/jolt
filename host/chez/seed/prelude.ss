(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "swap!" "Atomically swaps the value of atom to be:\n  (apply f current-value-of-atom args). Note that f may be called\n  multiple times, and thus should be free of side effects.  Returns\n  the value that was swapped in." (jolt-list (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "f") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "f") (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "f") (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "args")))))
