  (jv$clojure.core/attach-core-doc-meta! "clojure.java.io" "copy" "Copies input to output.  Returns nil or throws IOException.\n  Input may be an InputStream, Reader, File, byte[], char[], or String.\n  Output may be an OutputStream, Writer, or File.\n\n  Options are key/value pairs and may be one of\n\n    :buffer-size  buffer size to use, default is 1024.\n    :encoding     encoding to use if converting between\n                  byte and char streams.   \n\n  Does not close any streams except those it opens itself \n  (on a File)." (jolt-list (jolt-vector (jolt-symbol #f "input") (jolt-symbol #f "output") (jolt-symbol #f "&") (jolt-symbol #f "opts"))) jolt-nil))
