(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "take" "Returns a lazy sequence of the first n items in coll, or all items if\n  there are fewer than n.  Returns a stateful transducer when\n  no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "n")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")))))
