(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comment" "Ignores body, yields nil" (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "body"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "commute" "Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref.\n\n  At the commit point of the transaction, sets the value of ref to be:\n\n  (apply fun most-recently-committed-value-of-ref args)\n\n  Thus fun should be commutative, or, failing that, you must accept\n  last-one-in-wins behavior.  commute allows for more concurrency than\n  ref-set." (jolt-list (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "fun") (jolt-symbol #f "&") (jolt-symbol #f "args"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comp" "Takes a set of functions and returns a fn that is the composition\n  of those fns.  The returned fn takes a variable number of args,\n  applies the rightmost of fns to the args, the next\n  fn (right-to-left) to the result, etc." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g") (jolt-symbol #f "&") (jolt-symbol #f "fs"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comparator" "Returns an implementation of java.util.Comparator based upon pred." (jolt-list (jolt-vector (jolt-symbol #f "pred"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compare" "Comparator. Returns a negative number, zero, or a positive number\n  when x is logically 'less than', 'equal to', or 'greater than'\n  y. Same as Java x.compareTo(y) except it also works for nil, and\n  compares numbers and collections in a type-independent manner. x\n  must implement Comparable" (jolt-list (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compare-and-set!" "Atomically sets the value of atom to newval if and only if the\n  current value of the atom is identical to oldval. Returns true if\n  set happened, else false" (jolt-list (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "oldval") (jolt-symbol #f "newval"))) jolt-nil))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compile" "Compiles the namespace named by the symbol lib into a set of\n  classfiles. The source for the lib must be in a proper\n  classpath-relative directory. The output files will go into the\n  directory specified by *compile-path*, and that directory too must\n  be in the classpath." (jolt-list (jolt-vector (jolt-symbol #f "lib"))) jolt-nil))
