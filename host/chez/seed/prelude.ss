(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "realized?" "Returns true if a value has been produced for a promise, delay, future or lazy sequence." (jolt-list (jolt-vector (jolt-symbol #f "x")))))
