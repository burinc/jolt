(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "send" "Dispatch an action to an agent. Returns the agent immediately.\n  Subsequently, in a thread from a thread pool, the state of the agent\n  will be set to the value of:\n\n  (apply action-fn state-of-agent args)" (jolt-list (jolt-vector (jolt-symbol #f "a") (jolt-symbol #f "f") (jolt-symbol #f "&") (jolt-symbol #f "args")))))
