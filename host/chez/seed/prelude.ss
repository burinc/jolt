(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "=" "Equality. Returns true if x equals y, false if not. Same as\n  Java x.equals(y) except it also works for nil, and compares\n  numbers and collections in a type-independent manner.  Clojure's immutable data\n  structures define equals() (and thus =) as a value, not an identity,\n  comparison." (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "==" "Returns non-nil if nums all have the equivalent\n  value (type-independent), otherwise false" (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" ">" "Returns non-nil if nums are in monotonically decreasing order,\n  otherwise false." (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" ">=" "Returns non-nil if nums are in monotonically non-increasing order,\n  otherwise false." (jolt-list (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "NaN?" "Returns true if num is NaN, else false" (jolt-list (jolt-vector (jolt-symbol #f "num")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "PrintWriter-on" "implements java.io.PrintWriter given flush-fn, which will be called\n  when .flush() is called, with a string built up since the last call to .flush().\n  if not nil, close-fn will be called with no arguments when .close is called.\n  autoflush? determines if the PrintWriter will autoflush, false by default." (jolt-list (jolt-vector (jolt-symbol #f "flush-fn") (jolt-symbol #f "close-fn")) (jolt-vector (jolt-symbol #f "flush-fn") (jolt-symbol #f "close-fn") (jolt-symbol #f "autoflush?")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "StackTraceElement->vec" "Constructs a data representation for a StackTraceElement: [class method file line]" (jolt-list (jolt-vector (jolt-symbol #f "o")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "Throwable->map" "Constructs a data representation for a Throwable with keys:\n    :cause - root cause message\n    :phase - error phase\n    :via - cause chain, with cause keys:\n             :type - exception class symbol\n             :message - exception message\n             :data - ex-data\n             :at - top stack element\n    :trace - root cause stack elements" (jolt-list (jolt-vector (jolt-symbol #f "o")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "abs" "Returns the absolute value of a.\n  If a is Long/MIN_VALUE => Long/MIN_VALUE\n  If a is a double and zero => +0.0\n  If a is a double and ##Inf or ##-Inf => ##Inf\n  If a is a double and ##NaN => ##NaN" (jolt-list (jolt-vector (jolt-symbol #f "a")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "accessor" "Returns a fn that, given an instance of a structmap with the basis,\n  returns the value at the key.  The key must be in the basis. The\n  returned function should be (slightly) more efficient than using\n  get, but such use of accessors should be limited to known\n  performance-critical areas." (jolt-list (jolt-vector (jolt-symbol #f "s") (jolt-symbol #f "key")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "aclone" "Returns a clone of the Java array. Works on arrays of known\n  types." (jolt-list (jolt-vector (jolt-symbol #f "array")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "add-tap" "adds f, a fn of one argument, to the tap set. This function will be called with anything sent via tap>.\n  This function may (briefly) block (e.g. for streams), and will never impede calls to tap>,\n  but blocking indefinitely may cause tap values to be dropped.\n  Remember f in order to remove-tap" (jolt-list (jolt-vector (jolt-symbol #f "f")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "add-watch" "Adds a watch function to an agent/atom/var/ref reference. The watch\n  fn must be a fn of 4 args: a key, the reference, its old-state, its\n  new-state. Whenever the reference's state might have been changed,\n  any registered watches will have their functions called. The watch fn\n  will be called synchronously, on the agent's thread if an agent,\n  before any pending sends if agent or ref. Note that an atom's or\n  ref's state may have changed again prior to the fn call, so use\n  old/new-state rather than derefing the reference. Note also that watch\n  fns may be called from multiple threads simultaneously. Var watchers\n  are triggered only by root binding changes, not thread-local\n  set!s. Keys must be unique per reference, and can be used to remove\n  the watch with remove-watch, but are otherwise considered opaque by\n  the watch mechanism." (jolt-list (jolt-vector (jolt-symbol #f "reference") (jolt-symbol #f "key") (jolt-symbol #f "fn")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "agent" "Creates and returns an agent with an initial value of state and\n  zero or more options (in any order):\n\n  :meta metadata-map\n\n  :validator validate-fn\n\n  :error-handler handler-fn\n\n  :error-mode mode-keyword\n\n  If metadata-map is supplied, it will become the metadata on the\n  agent. validate-fn must be nil or a side-effect-free fn of one\n  argument, which will be passed the intended new state on any state\n  change. If the new state is unacceptable, the validate-fn should\n  return false or throw an exception.  handler-fn is called if an\n  action throws an exception or if validate-fn rejects a new state --\n  see set-error-handler! for details.  The mode-keyword may be either\n  :continue (the default if an error-handler is given) or :fail (the\n  default if no error-handler is given) -- see set-error-mode! for\n  details." (jolt-list (jolt-vector (jolt-symbol #f "state") (jolt-symbol #f "&") (jolt-symbol #f "options")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "agent-error" "Returns the exception thrown during an asynchronous action of the\n  agent if the agent is failed.  Returns nil if the agent is not\n  failed." (jolt-list (jolt-vector (jolt-symbol #f "a")))))
(guard (e (#t #f))
