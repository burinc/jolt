(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "double?" "Return true if x is a Double" (jolt-list (jolt-vector (jolt-symbol #f "x")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "doubles" "Casts to double[]" (jolt-list (jolt-vector (jolt-symbol #f "xs")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "drop" "Returns a laziness-preserving sequence of all but the first n items in coll.\n  Returns a stateful transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "n")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "drop-last" "Return a lazy sequence of all but the last n (default 1) items in coll" (jolt-list (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "n") (jolt-symbol #f "coll")))))
