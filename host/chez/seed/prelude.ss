(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "coll?" "Returns true if x implements IPersistentCollection" (jolt-list (jolt-vector (jolt-symbol #f "x")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comment" "Ignores body, yields nil" (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "body")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "commute" "Must be called in a transaction. Sets the in-transaction-value of\n  ref to:\n\n  (apply fun in-transaction-value-of-ref args)\n\n  and returns the in-transaction-value of ref.\n\n  At the commit point of the transaction, sets the value of ref to be:\n\n  (apply fun most-recently-committed-value-of-ref args)\n\n  Thus fun should be commutative, or, failing that, you must accept\n  last-one-in-wins behavior.  commute allows for more concurrency than\n  ref-set." (jolt-list (jolt-vector (jolt-symbol #f "ref") (jolt-symbol #f "fun") (jolt-symbol #f "&") (jolt-symbol #f "args")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comp" "Takes a set of functions and returns a fn that is the composition\n  of those fns.  The returned fn takes a variable number of args,\n  applies the rightmost of fns to the args, the next\n  fn (right-to-left) to the result, etc." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g") (jolt-symbol #f "&") (jolt-symbol #f "fs")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comparator" "Returns an implementation of java.util.Comparator based upon pred." (jolt-list (jolt-vector (jolt-symbol #f "pred")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compare" "Comparator. Returns a negative number, zero, or a positive number\n  when x is logically 'less than', 'equal to', or 'greater than'\n  y. Same as Java x.compareTo(y) except it also works for nil, and\n  compares numbers and collections in a type-independent manner. x\n  must implement Comparable" (jolt-list (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compare-and-set!" "Atomically sets the value of atom to newval if and only if the\n  current value of the atom is identical to oldval. Returns true if\n  set happened, else false" (jolt-list (jolt-vector (jolt-symbol #f "atom") (jolt-symbol #f "oldval") (jolt-symbol #f "newval")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "compile" "Compiles the namespace named by the symbol lib into a set of\n  classfiles. The source for the lib must be in a proper\n  classpath-relative directory. The output files will go into the\n  directory specified by *compile-path*, and that directory too must\n  be in the classpath." (jolt-list (jolt-vector (jolt-symbol #f "lib")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "complement" "Takes a fn f and returns a fn that takes the same arguments as f,\n  has the same effects, if any, and returns the opposite truth value." (jolt-list (jolt-vector (jolt-symbol #f "f")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "completing" "Takes a reducing function f of 2 args and returns a fn suitable for\n  transduce by adding an arity-1 signature that calls cf (default -\n  identity) on the result argument." (jolt-list (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "cf")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "concat" "Returns a lazy seq representing the concatenation of the elements in the supplied colls." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "y") (jolt-symbol #f "&") (jolt-symbol #f "zs")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "cond" "Takes a set of test/expr pairs. It evaluates each test one at a\n  time.  If a test returns logical true, cond evaluates and returns\n  the value of the corresponding expr and doesn't evaluate any of the\n  other tests or exprs. (cond) returns nil." (jolt-list (jolt-vector (jolt-symbol #f "&") (jolt-symbol #f "clauses")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "cond->" "Takes an expression and a set of test/form pairs. Threads expr (via ->)\n  through each form for which the corresponding test\n  expression is true. Note that, unlike cond branching, cond-> threading does\n  not short circuit after the first true test expression." (jolt-list (jolt-vector (jolt-symbol #f "expr") (jolt-symbol #f "&") (jolt-symbol #f "clauses")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "cond->>" "Takes an expression and a set of test/form pairs. Threads expr (via ->>)\n  through each form for which the corresponding test expression\n  is true.  Note that, unlike cond branching, cond->> threading does not short circuit\n  after the first true test expression." (jolt-list (jolt-vector (jolt-symbol #f "expr") (jolt-symbol #f "&") (jolt-symbol #f "clauses")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "condp" "Takes a binary predicate, an expression, and a set of clauses.\n  Each clause can take the form of either:\n\n  test-expr result-expr\n\n  test-expr :>> result-fn\n\n  Note :>> is an ordinary keyword.\n\n  For each clause, (pred test-expr expr) is evaluated. If it returns\n  logical true, the clause is a match. If a binary clause matches, the\n  result-expr is returned, if a ternary clause matches, its result-fn,\n  which must be a unary function, is called with the result of the\n  predicate as its argument, the result of that call being the return\n  value of condp. A single default expression can follow the clauses,\n  and its value will be returned if no clause matches. If no default\n  expression is provided and no clause matches, an\n  IllegalArgumentException is thrown." (jolt-list (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "expr") (jolt-symbol #f "&") (jolt-symbol #f "clauses")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "conj" "conj[oin]. Returns a new collection with the xs\n    'added'. (conj nil item) returns (item).\n    (conj coll) returns coll. (conj) returns [].\n    The 'addition' may happen at different 'places' depending\n    on the concrete type." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "coll")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x")) (jolt-vector (jolt-symbol #f "coll") (jolt-symbol #f "x") (jolt-symbol #f "&") (jolt-symbol #f "xs")))))
