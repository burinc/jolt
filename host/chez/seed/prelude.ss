  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "dissoc!" "Returns a transient map that doesn't contain a mapping for key(s)." (jolt-list (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key")) (jolt-vector (jolt-symbol #f "map") (jolt-symbol #f "key") (jolt-symbol #f "&") (jolt-symbol #f "ks")))))
