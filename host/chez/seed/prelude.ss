  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "clear-agent-errors" "DEPRECATED: Use 'restart-agent' instead.\n  Clears any exceptions thrown during asynchronous actions of the\n  agent, allowing subsequent actions to occur." (jolt-list (jolt-vector (jolt-symbol #f "a")))))
(guard (e (#t #f))
