  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "drop-while" "Returns a lazy sequence of the items in coll starting from the\n  first item for which (pred item) returns logical false.  Returns a\n  stateful transducer when no collection is provided." (jolt-list (jolt-vector (jolt-symbol #f "pred")) (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "eduction" "Returns a reducible/iterable application of the transducers\n  to the items in coll. Transducers are applied in order as if\n  combined with comp. Note that these applications will be\n  performed every time reduce/iterator is called." (jolt-list (jolt-vector (jolt-symbol #f "xform*") (jolt-symbol #f "coll")))))
