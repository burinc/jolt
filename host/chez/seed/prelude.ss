  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "sync" "transaction-flags => TBD, pass nil for now\n\n  Runs the exprs (in an implicit do) in a transaction that encompasses\n  exprs and any nested calls.  Starts a transaction if none is already\n  running on this thread. Any uncaught exception will abort the\n  transaction and flow out of sync. The exprs may be run more than\n  once, but any effects on Refs will be atomic." (jolt-list (jolt-vector (jolt-symbol #f "flags-ignored-for-now") (jolt-symbol #f "&") (jolt-symbol #f "body")))))
