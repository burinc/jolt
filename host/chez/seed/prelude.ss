(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "->Eduction" "Positional factory function for class clojure.core.Eduction." (jolt-list (jolt-vector (jolt-symbol #f "xform") (jolt-symbol #f "coll")))))
(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" ".." "form => fieldName-symbol or (instanceMethodName-symbol args*)\n\n  Expands into a member access (.) of the first member on the first\n  argument, followed by the next member on the result, etc. For\n  instance:\n\n  (.. System (getProperties) (get \"os.name\"))\n\n  expands to:\n\n  (. (. System (getProperties)) (get \"os.name\"))\n\n  but is easier to write, read, and understand." (jolt-list (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "form")) (jolt-vector (jolt-symbol #f "x") (jolt-symbol #f "form") (jolt-symbol #f "&") (jolt-symbol #f "more")))))
