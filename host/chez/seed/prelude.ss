  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "some" "Returns the first logical true value of (pred x) for any x in coll,\n  else nil.  One common idiom is to use a set as pred, for example\n  this will return :fred if :fred is in the sequence, otherwise nil:\n  (some #{:fred} coll)" (jolt-list (jolt-vector (jolt-symbol #f "pred") (jolt-symbol #f "coll")))))
