  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "comp" "Takes a set of functions and returns a fn that is the composition\n  of those fns.  The returned fn takes a variable number of args,\n  applies the rightmost of fns to the args, the next\n  fn (right-to-left) to the result, etc." (jolt-list (jolt-vector ) (jolt-vector (jolt-symbol #f "f")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g")) (jolt-vector (jolt-symbol #f "f") (jolt-symbol #f "g") (jolt-symbol #f "&") (jolt-symbol #f "fs"))) jolt-nil))
