(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "set-agent-send-executor!" "Sets the ExecutorService to be used by send" (jolt-list (jolt-vector (jolt-symbol #f "executor")))))
(guard (e (#t #f))
