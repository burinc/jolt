(guard (e (#t #f))
  (jv$clojure.core/attach-core-doc-meta! "clojure.core" "for" "List comprehension. Takes a vector of one or more\n   binding-form/collection-expr pairs, each followed by zero or more\n   modifiers, and yields a lazy sequence of evaluations of expr.\n   Collections are iterated in a nested fashion, rightmost fastest,\n   and nested coll-exprs can refer to bindings created in prior\n   binding-forms.  Supported modifiers are: :let [binding-form expr ...],\n   :while test, :when test.\n\n  (take 100 (for [x (range 100000000) y (range 1000000) :while (< y x)] [x y]))" (jolt-list (jolt-vector (jolt-symbol #f "seq-exprs") (jolt-symbol #f "body-expr")))))
