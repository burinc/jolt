  (jv$clojure.core$attach-core-doc-meta! "clojure.core" "push-thread-bindings" "WARNING: This is a low-level function. Prefer high-level macros like\n  binding where ever possible.\n\n  Takes a map of Var/value pairs. Binds each Var to the associated value for\n  the current thread. Each call *MUST* be accompanied by a matching call to\n  pop-thread-bindings wrapped in a try-finally!\n  \n      (push-thread-bindings bindings)\n      (try\n        ...\n        (finally\n          (pop-thread-bindings)))" (jolt-list (jolt-vector (jolt-symbol #f "bindings")))))
