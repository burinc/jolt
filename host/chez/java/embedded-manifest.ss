;; java.util.jar.Manifest, Attributes, and Attributes.Name.

(define (manifest-key key)
  (cond ((and (jhost? key) (string=? (jhost-tag key) "attributes-name")) (jhost-state key))
        ((string? key) key)
        (else (jolt-str-render-one key))))
(define (manifest-key=? a b) (string-ci=? (manifest-key a) (manifest-key b)))
(define (manifest-assoc key alist)
  (cond ((null? alist) #f)
        ((manifest-key=? key (caar alist)) (car alist))
        (else (manifest-assoc key (cdr alist)))))
(define (manifest-remove key alist)
  (filter (lambda (p) (not (manifest-key=? key (car p)))) alist))
(define (manifest-canonical alist)
  (sort (lambda (a b) (string-ci<? (car a) (car b)))
        (map (lambda (p) (cons (string-downcase (car p)) (cdr p))) alist)))
(define (manifest-attributes-copy self)
  (make-jhost "jar-attributes" (map (lambda (p) (cons (car p) (cdr p))) (jhost-state self))))
(define (manifest-attributes-put! self key value)
  (let* ((key (manifest-key key)) (old (manifest-assoc key (jhost-state self))))
    (jhost-state-set! self (cons (cons key value) (manifest-remove key (jhost-state self))))
    (if old (cdr old) jolt-nil)))
(define (manifest-attributes-store! self entries)
  (jhost-state-set! self entries))

(define (attributes-name-ctor name)
  (let ((s (jolt-str-render-one name)) (n (string-length (jolt-str-render-one name))))
    (when (or (= n 0) (> n 70))
      (throw-jvm 'IllegalArgumentException "attribute name must have 1-70 characters"))
    (let loop ((i 0))
      (when (< i n)
        (let ((c (string-ref s i)))
          (unless (or (char-alphabetic? c) (char-numeric? c) (char=? c #\_) (char=? c #\-))
            (throw-jvm 'IllegalArgumentException (string-append "invalid attribute name: " s))))
        (loop (+ i 1))))
    (make-jhost "attributes-name" s)))
(register-class-ctor! "Attributes$Name" attributes-name-ctor)
(register-class-ctor! "java.util.jar.Attributes$Name" attributes-name-ctor)
(register-host-methods! "attributes-name"
  (list (cons "toString" (lambda (self) (jhost-state self)))
        (cons "equals" (lambda (self other)
                         (and (jhost? other) (string=? (jhost-tag other) "attributes-name")
                              (string-ci=? (jhost-state self) (jhost-state other)))))
        (cons "hashCode" (lambda (self) (java-string-hashcode (string-downcase (jhost-state self)))))))
(register-eq-arm! (lambda (a b) (and (jhost? a) (jhost? b)
                                     (string=? (jhost-tag a) "attributes-name")
                                     (string=? (jhost-tag b) "attributes-name")))
                  (lambda (a b) (string-ci=? (jhost-state a) (jhost-state b))))
(register-hash-arm! (lambda (x) (and (jhost? x) (string=? (jhost-tag x) "attributes-name")))
                    (lambda (x) (java-string-hashcode (string-downcase (jhost-state x)))))

(define (manifest-attribute-public-key key)
  (if (and (jhost? key) (string=? (jhost-tag key) "attributes-name"))
      key
      (attributes-name-ctor key)))
(define (manifest-view-items self)
  (let ((kind (vector-ref (jhost-state self) 1)))
    (map (lambda (p)
           (case kind
             ((keys) (manifest-attribute-public-key (car p)))
             ((values) (cdr p))
             (else (make-pvec (vector (manifest-attribute-public-key (car p)) (cdr p))))))
         (jhost-state (vector-ref (jhost-state self) 0)))))
(define (manifest-view-remove! self item)
  (let* ((attrs (vector-ref (jhost-state self) 0))
         (kind (vector-ref (jhost-state self) 1))
         (hit (cond ((eq? kind 'keys) (manifest-assoc item (jhost-state attrs)))
                    ((eq? kind 'values) (find (lambda (p) (equal? (cdr p) item)) (jhost-state attrs)))
                    (else (let ((p (manifest-assoc (jolt-get item 0) (jhost-state attrs))))
                            (and p (equal? (cdr p) (jolt-get item 1)) p))))))
    (when hit
      (manifest-attributes-store! attrs (manifest-remove (car hit) (jhost-state attrs))))
    (and hit #t)))
(register-jutil-iterator! "jar-attributes-view-iterator")
(register-host-methods! "jar-attributes-view"
  (list
   (cons "size" (lambda (self) (length (manifest-view-items self))))
   (cons "isEmpty" (lambda (self) (null? (manifest-view-items self))))
   (cons "contains"
         (lambda (self item)
           (let ((kind (vector-ref (jhost-state self) 1)))
             (and (find (lambda (candidate)
                          (if (eq? kind 'entries)
                              (and (manifest-key=? (jolt-get candidate 0) (jolt-get item 0))
                                   (equal? (jolt-get candidate 1) (jolt-get item 1)))
                              (equal? candidate item)))
                        (manifest-view-items self)) #t))))
   (cons "remove" manifest-view-remove!)
   (cons "clear" (lambda (self)
                   (manifest-attributes-store! (vector-ref (jhost-state self) 0) '()) jolt-nil))
   (cons "add" (lambda (self item) (throw-jvm 'UnsupportedOperationException "map views are not addable")))
   (cons "iterator"
         (lambda (self)
           (make-jutil-iterator "jar-attributes-view-iterator" (manifest-view-items self)
                                (lambda (item) (manifest-view-remove! self item))
                                (lambda (item) item))))
   (cons "toArray" (case-lambda
                     ((self) (jcoll-to-array (manifest-view-items self) '()))
                     ((self a) (jcoll-to-array (manifest-view-items self) (list a)))))))
(register-jutil-coll! "jar-attributes-view" 'coll manifest-view-items)
(define (jar-attributes-view? x)
  (and (jhost? x) (string=? (jhost-tag x) "jar-attributes-view")))
(register-seq-arm! jar-attributes-view?
  (lambda (self) (let ((items (manifest-view-items self)))
                   (if (null? items) jolt-nil (list->cseq items)))))
(register-count-arm! jar-attributes-view? (lambda (self) (length (manifest-view-items self))))
(register-contains-arm! jar-attributes-view?
  (lambda (self item) (jolt-truthy? (record-method-dispatch self "contains" #f item))))
(hashtable-set! jhost-tag->fqn "jar-attributes-view" "java.util.Collection")

(register-host-methods! "jar-attributes"
  (list
   (cons "get" (lambda (self key) (let ((hit (manifest-assoc key (jhost-state self))))
                                    (if hit (cdr hit) jolt-nil))))
   (cons "getValue" (lambda (self key) (let ((hit (manifest-assoc key (jhost-state self))))
                                         (if hit (cdr hit) jolt-nil))))
   (cons "put" (lambda (self key value) (manifest-attributes-put! self key value)))
   (cons "putValue" (lambda (self key value) (manifest-attributes-put! self key value)))
   (cons "remove" (lambda (self key)
                    (let ((old (manifest-assoc key (jhost-state self))))
                      (manifest-attributes-store! self (manifest-remove key (jhost-state self)))
                      (if old (cdr old) jolt-nil))))
   (cons "containsValue" (lambda (self value)
                           (and (exists (lambda (p) (equal? (cdr p) value)) (jhost-state self)) #t)))
   (cons "containsKey" (lambda (self key) (and (manifest-assoc key (jhost-state self)) #t)))
   (cons "putAll" (lambda (self m)
                    (for-each (lambda (p) (manifest-attributes-put! self (jolt-get p 0) (jolt-get p 1)))
                              (seq->list (jolt-seq m)))
                    jolt-nil))
   (cons "clear" (lambda (self) (manifest-attributes-store! self '()) jolt-nil))
   (cons "size" (lambda (self) (length (jhost-state self))))
   (cons "isEmpty" (lambda (self) (null? (jhost-state self))))
   (cons "keySet" (lambda (self) (make-jhost "jar-attributes-view" (vector self 'keys))))
   (cons "values" (lambda (self) (make-jhost "jar-attributes-view" (vector self 'values))))
   (cons "entrySet" (lambda (self) (make-jhost "jar-attributes-view" (vector self 'entries))))
   (cons "clone" manifest-attributes-copy)
   (cons "equals" (lambda (self other)
                    (and (jhost? other) (string=? (jhost-tag other) "jar-attributes")
                         (equal? (manifest-canonical (jhost-state self))
                                 (manifest-canonical (jhost-state other))))))
   (cons "hashCode" (lambda (self) (equal-hash (manifest-canonical (jhost-state self)))))))
(register-eq-arm! (lambda (a b) (and (jhost? a) (jhost? b)
                                     (string=? (jhost-tag a) "jar-attributes")
                                     (string=? (jhost-tag b) "jar-attributes")))
                  (lambda (a b) (equal? (manifest-canonical (jhost-state a))
                                        (manifest-canonical (jhost-state b)))))
(register-hash-arm! (lambda (x) (and (jhost? x) (string=? (jhost-tag x) "jar-attributes")))
                    (lambda (x) (equal-hash (manifest-canonical (jhost-state x)))))

(define (make-manifest-attributes) (make-jhost "jar-attributes" '()))
(define (manifest-copy self)
  (make-jhost "jar-manifest"
              (vector (manifest-attributes-copy (vector-ref (jhost-state self) 0))
                      (map (lambda (p) (cons (car p) (manifest-attributes-copy (cdr p))))
                           (vector-ref (jhost-state self) 1)))))
(define (manifest-main self) (vector-ref (jhost-state self) 0))
(define (manifest-entries self) (vector-ref (jhost-state self) 1))
(define (manifest-entry self name)
  (let ((hit (find (lambda (p) (string=? (car p) name)) (manifest-entries self))))
    (if hit (cdr hit) jolt-nil)))
(define (manifest-entry-map self)
  (fold-left (lambda (m p) (jolt-assoc m (car p) (cdr p))) empty-pmap (manifest-entries self)))
(define (manifest-canonical-self self)
  (list (manifest-canonical (jhost-state (manifest-main self)))
        (sort string-ci<? (map (lambda (p) (cons (car p) (manifest-canonical (jhost-state (cdr p)))))
                               (manifest-entries self)))))
(register-host-methods! "jar-manifest"
  (list
   (cons "getMainAttributes" manifest-main)
   (cons "getEntries" manifest-entry-map)
   (cons "getAttributes" manifest-entry)
   (cons "clear" (lambda (self)
                   (vector-set! (jhost-state self) 0 (make-manifest-attributes))
                   (vector-set! (jhost-state self) 1 '()) jolt-nil))
   (cons "write" (lambda (self out) (manifest-write self out) jolt-nil))
   (cons "read" (lambda (self in)
                  (let-values (((main entries) (manifest-read in)))
                    (vector-set! (jhost-state self) 0 main)
                    (vector-set! (jhost-state self) 1 entries)
                    jolt-nil)))
   (cons "equals" (lambda (self other)
                    (and (jhost? other) (string=? (jhost-tag other) "jar-manifest")
                         (equal? (manifest-canonical-self self) (manifest-canonical-self other)))))
   (cons "hashCode" (lambda (self) (equal-hash (manifest-canonical-self self))))
   (cons "clone" manifest-copy)))
(register-eq-arm! (lambda (a b) (and (jhost? a) (jhost? b)
                                     (string=? (jhost-tag a) "jar-manifest")
                                     (string=? (jhost-tag b) "jar-manifest")))
                  (lambda (a b) (equal? (manifest-canonical-self a) (manifest-canonical-self b))))
(register-hash-arm! (lambda (x) (and (jhost? x) (string=? (jhost-tag x) "jar-manifest")))
                    (lambda (x) (equal-hash (manifest-canonical-self x))))

(define (manifest-lines text)
  (let ((text (if (and (> (string-length text) 0) (char=? (string-ref text 0) (integer->char #xFEFF)))
                  (substring text 1 (string-length text)) text)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond
        ((= i (string-length text))
         (let ((lines (reverse (if (> i start) (cons (substring text start i) acc) acc))))
           (let unfold ((ls lines) (out '()))
             (cond ((null? ls) (reverse out))
                   ((and (> (string-length (car ls)) 0) (char=? (string-ref (car ls) 0) #\space)
                         (pair? out))
                    (unfold (cdr ls)
                            (cons (string-append (car out) (substring (car ls) 1 (string-length (car ls))))
                                  (cdr out))))
                   (else (unfold (cdr ls) (cons (car ls) out)))))))
        ((char=? (string-ref text i) #\newline)
         (let* ((end (if (and (> i start) (char=? (string-ref text (- i 1)) #\return)) (- i 1) i))
                (line (substring text start end)))
           (loop (+ i 1) (+ i 1) (cons line acc))))
        (else (loop (+ i 1) start acc))))))

(define (manifest-parse-line line)
  (let ((colon (let loop ((i 0))
                 (cond ((>= i (string-length line)) #f)
                       ((char=? (string-ref line i) #\:) i)
                       (else (loop (+ i 1)))))))
    (and colon
         (cons (substring line 0 colon)
               (let ((start (if (and (< (+ colon 1) (string-length line))
                                     (char=? (string-ref line (+ colon 1)) #\space))
                                (+ colon 2) (+ colon 1))))
                 (if (< start (string-length line))
                     (substring line start (string-length line)) ""))))))
(define (manifest-read in)
  (let* ((port (in-stream-source-port in))
         (bv (get-bytevector-all port))
         (text (utf8->string (if (eof-object? bv) (make-bytevector 0) bv))))
    (let loop ((lines (manifest-lines text)) (section #f) (main (make-manifest-attributes)) (entries '()))
      (if (null? lines)
          (values main (reverse entries))
          (let ((line (car lines)))
            (if (string=? line "")
                (loop (cdr lines) #f main entries)
                (let ((field (manifest-parse-line line)))
                  (unless field (throw-jvm 'java.io.IOException "invalid manifest"))
                  (if (and (not section) (string-ci=? (car field) "Name"))
                      (loop (cdr lines) (cdr field) main entries)
                      (begin
                        (manifest-attributes-put! (if section
                                                      (let ((hit (find (lambda (p) (string=? (car p) section)) entries)))
                                                        (if hit (cdr hit)
                                                            (let ((attrs (make-manifest-attributes)))
                                                              (set! entries (cons (cons section attrs) entries))
                                                              attrs)))
                                                      main)
                                                  (car field) (cdr field))
                        (loop (cdr lines) section main entries))))))))))
(define (manifest-write-raw out text)
  (let ((bv (string->utf8 text)))
    (record-method-dispatch out "write"
      (list->cseq (list (na-byte-array bv) (->num 0) (->num (bytevector-length bv)))))))
(define (manifest-write-line out text)
  (let ((n (string-length text)))
    (let loop ((start 0) (first? #t))
      (when (< start n)
        (let* ((budget (if first? 72 71))
               (end (let scan ((i start) (used 0))
                      (if (>= i n)
                          n
                          (let ((width (bytevector-length (string->utf8 (string (string-ref text i))))))
                            (if (> (+ used width) budget)
                                i
                                (scan (+ i 1) (+ used width))))))))
          (manifest-write-raw out (string-append (if first? "" " ")
                                                 (substring text start end) "\r\n"))
          (loop end #f))))))
(define (manifest-write-attribute out p)
  (manifest-write-line out
    (string-append (car p) ":" (if (and (> (string-length (cdr p)) 0)
                                        (char=? (string-ref (cdr p) 0) #\space))
                                    "" " ") (cdr p))))
(define (manifest-write-attributes out attrs . excluded)
  (for-each (lambda (p)
              (unless (and (pair? excluded) (manifest-key=? (car p) (car excluded)))
                (manifest-write-attribute out p)))
            (jhost-state attrs)))
(define (manifest-write self out)
  (let ((version (manifest-assoc "Manifest-Version" (jhost-state (manifest-main self)))))
    (when version (manifest-write-attribute out version))
    (manifest-write-attributes out (manifest-main self) "Manifest-Version")
    (for-each (lambda (p)
                (manifest-write-raw out "\r\n")
                (manifest-write-line out (string-append "Name: " (car p)))
                (manifest-write-attributes out (cdr p)))
              (manifest-entries self))))
(define (manifest-ctor . args)
  (let ((self (make-jhost "jar-manifest" (vector (make-manifest-attributes) '()))))
    (cond
      ((null? args) self)
      ((and (= (length args) 1) (jhost? (car args)) (string=? (jhost-tag (car args)) "jar-manifest"))
       (manifest-copy (car args)))
      ((= (length args) 1)
       (let-values (((main entries) (manifest-read (car args))))
         (vector-set! (jhost-state self) 0 main)
         (vector-set! (jhost-state self) 1 entries)
         self))
      (else (throw-jvm 'IllegalArgumentException "No matching ctor found for class java.util.jar.Manifest")))))
(register-class-ctor! "Manifest" manifest-ctor)
(register-class-ctor! "java.util.jar.Manifest" manifest-ctor)
(register-class-ctor! "Attributes" (lambda args (make-manifest-attributes)))
(register-class-ctor! "java.util.jar.Attributes"
  (lambda args
    (cond ((null? args) (make-manifest-attributes))
          ((and (= (length args) 1) (number? (car args))) (make-manifest-attributes))
          ((and (= (length args) 1) (jhost? (car args)) (string=? (jhost-tag (car args)) "jar-attributes"))
           (manifest-attributes-copy (car args)))
          (else (throw-jvm 'IllegalArgumentException "No matching ctor found for class java.util.jar.Attributes")))))

(hashtable-set! jhost-tag->fqn "attributes-name" "java.util.jar.Attributes$Name")
(hashtable-set! jhost-tag->fqn "jar-attributes" "java.util.jar.Attributes")
(hashtable-set! jhost-tag->fqn "jar-manifest" "java.util.jar.Manifest")

(define (embedded-jar-manifest archive)
  (let ((content (embedded-resource-ref "META-INF/MANIFEST.MF")))
    (if (not content)
        jolt-nil
        (manifest-ctor (make-in-stream (open-bytevector-input-port
                                        (if (bytevector? content) content (string->utf8 content))))))))
(define (embedded-jar-main-attributes archive)
  (let ((manifest (embedded-jar-manifest archive)))
    (if (jolt-nil? manifest) jolt-nil (manifest-main manifest))))
(define (embedded-jar-entry-attributes archive name)
  (let ((manifest (embedded-jar-manifest archive)))
    (if (jolt-nil? manifest) jolt-nil (manifest-entry manifest name))))
