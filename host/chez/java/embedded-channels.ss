;; Read-only byte channels and stream-producing Files operations.

(define (embedded-channel-ensure-open self)
  (unless (vector-ref (jhost-state self) 2)
    (throw-jvm 'java.nio.channels.ClosedChannelException "embedded channel is closed")))
(define (embedded-channel-position self) (vector-ref (jhost-state self) 1))
(define (embedded-channel-position-set! self position)
  (embedded-channel-ensure-open self)
  (let ((position (jnum->exact position)))
    (when (< position 0)
      (throw-jvm 'IllegalArgumentException "negative channel position"))
    (vector-set! (jhost-state self) 1 position)
    self))

(define (embedded-channel-read self buffer)
  (embedded-channel-ensure-open self)
  (let* ((bytes (vector-ref (jhost-state self) 0))
         (position (embedded-channel-position self))
         (remaining (- (bytevector-length bytes) position))
         (n (min remaining (nb-remaining buffer))))
    (cond ((= (nb-remaining buffer) 0) (->num 0))
          ((<= n 0) (->num -1))
          (else
           (let ((slice (make-bytevector n)))
             (bytevector-copy! bytes position slice 0 n)
             (nb-put buffer (na-byte-array slice) 0 n)
             (embedded-channel-position-set! self (+ position n))
             (->num n))))))

(register-host-methods! "embedded-byte-channel"
  (list
   (cons "read" embedded-channel-read)
   (cons "write" (lambda (self buffer)
                   (embedded-channel-ensure-open self)
                   (zip-throw "java.nio.file.ReadOnlyFileSystemException" "write")))
   (cons "position" (lambda (self . position)
                      (embedded-channel-ensure-open self)
                      (if (pair? position)
                          (embedded-channel-position-set! self (car position))
                          (embedded-channel-position self))))
   (cons "size" (lambda (self)
                  (embedded-channel-ensure-open self)
                  (->num (bytevector-length (vector-ref (jhost-state self) 0)))))
   (cons "truncate" (lambda (self size)
                      (embedded-channel-ensure-open self)
                      (zip-throw "java.nio.file.ReadOnlyFileSystemException" "truncate")))
   (cons "isOpen" (lambda (self) (vector-ref (jhost-state self) 2)))
   (cons "close" (lambda (self) (vector-set! (jhost-state self) 2 #f) jolt-nil))))
(hashtable-set! jhost-tag->fqn "embedded-byte-channel" "java.nio.channels.SeekableByteChannel")
(hashtable-set! jhost-tag->fqn "embedded-file-channel" "java.nio.channels.FileChannel")
(alias-host-methods! "embedded-file-channel" "embedded-byte-channel")

(define (embedded-channel-options path options)
  (when (exists (lambda (option)
                  (and (jhost? option)
                       (member (enum-name option) '("WRITE" "APPEND" "TRUNCATE_EXISTING" "CREATE" "CREATE_NEW" "DELETE_ON_CLOSE"))))
                (npath-spread-args options))
    (zip-throw "java.nio.file.ReadOnlyFileSystemException" "open for writing"))
  (embedded-nio-bytes path))
(define (embedded-byte-channel path . options)
  (make-jhost "embedded-byte-channel" (vector (embedded-channel-options path options) 0 #t)))
(define (embedded-file-channel path . options)
  (make-jhost "embedded-file-channel" (vector (embedded-channel-options path options) 0 #t)))

(define (embedded-nio-buffered-reader path args)
  (let ((stream (make-in-stream (open-bytevector-input-port (embedded-nio-bytes path)))))
    (host-new "BufferedReader"
              (if (pair? args)
                  (host-new "InputStreamReader" stream (npath-string-of (car args)))
                  (host-new "InputStreamReader" stream "UTF-8")))))

(define (embedded-nio-decode path args)
  (let* ((bytes (embedded-nio-bytes path))
         (charset (charset-for-name (string-charset-name args)))
         (decoder (make-jhost "charset-decoder" (vector charset #f #f "\xFFFD;")))
         (buffer (nb-wrap-bytes (na-byte-array bytes) 0 (bytevector-length bytes)))
         (decoded (decoder-decode-all decoder buffer)))
    (nb-char-string decoded (bb-pos decoded) (bb-limit decoded))))

(define (embedded-nio-any-bytes path)
  (if (embedded-nio-path? path)
      (embedded-nio-bytes path)
      (nio-read-bv (nfp path) (nio-shown path))))
(define (embedded-mismatch first second)
  (let* ((a (embedded-nio-any-bytes first))
         (b (embedded-nio-any-bytes second))
         (n (min (bytevector-length a) (bytevector-length b))))
    (let loop ((i 0))
      (cond
        ((< i n)
         (if (= (bytevector-u8-ref a i) (bytevector-u8-ref b i))
             (loop (+ i 1))
             (->num i)))
        ((= (bytevector-length a) (bytevector-length b)) (->num -1))
        (else (->num n))))))

(define (embedded-nio-walk-list start max-depth)
  (embedded-nio-require start)
  (let walk ((path start) (depth 0) (acc '()))
    (let ((acc (cons path acc)))
      (if (and (eq? (embedded-nio-kind path) 'directory) (< depth max-depth))
          (let ((children (embedded-nio-children path)))
            (let loop ((children children) (acc acc))
              (if (null? children)
                  acc
                  (loop (cdr children) (walk (car children) (+ depth 1) acc)))))
          acc))))
(define (embedded-nio-reverse-flatten paths)
  (let loop ((paths paths) (acc '()))
    (if (null? paths)
        acc
        (loop (cdr paths) (cons (car paths) acc)))))

(define (embedded-path-stream operation path args)
  (cond
    ((string=? operation "list") (make-stream 'ref (list->cseq (embedded-nio-children path))))
    ((string=? operation "walk")
     (let ((depth (if (and (pair? args) (number? (car args))) (car args) 2147483647)))
       (make-stream 'ref (list->cseq (embedded-nio-reverse-flatten (embedded-nio-walk-list path depth))))))
    ((string=? operation "find")
     (let ((depth (if (number? (car args)) (car args) 2147483647))
           (predicate (cadr args)))
       (make-stream 'ref
         (list->cseq
          (filter (lambda (candidate)
                    (jolt-truthy? (jolt-invoke predicate candidate (make-embedded-basic-attrs candidate))))
                  (embedded-nio-reverse-flatten (embedded-nio-walk-list path depth)))))))
    ((string=? operation "lines")
     (make-stream 'ref (embedded-nio-read-lines path args)))
    (else (throw-jvm 'UnsupportedOperationException operation))))

(define (embedded-nio-content-type path)
  (embedded-resource-content-type (embedded-nio-resource-name path)))
